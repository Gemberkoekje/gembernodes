# The API container's environment (configMapGenerator in kustomization.yaml). A change here gives
# the ConfigMap a new name, so Flux rolls the pod and the change takes effect.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
# The port the Prometheus annotations in deployment-api.yaml point at.
Metrics__Port=9090
# Serilog levels. appsettings.json sets Information, and Warning for ASP.NET Core, EF Core,
# Wolverine, JasperFx and System.Net.Http; a key here overrides one. To look closer at a part of
# the bot, for example:
#   Serilog__MinimumLevel__Override__SpaceTraders.Application.Automation=Debug
Serilog__MinimumLevel__Default=Information
