# secret.yaml.template
#
# This file documents the shape of the Kubernetes Secret expected by the
# spacetraders namespace.  It is NOT applied directly — the actual secret is
# provisioned by the 1Password Operator via spacetraders-secrets.yaml.
#
# Make sure the following fields exist in the
#   vaults/Gembercluster/items/spacetraders-secrets
# 1Password item, with exactly these labels: the deployments read each one by
# name, and a missing field keeps the pod in CreateContainerConfigError. Other
# fields in the item are ignored.
#
# To create the secret manually (e.g. for local testing), fill in the values
# below and apply with:
#   kubectl apply -f secret.yaml
#
# WARNING: Do NOT commit the filled-in secret.yaml to version control.

apiVersion: v1
kind: Secret
metadata:
  name: spacetraders-secrets
  namespace: spacetraders
type: Opaque
stringData:
  # The bot's own login, which owns only the spacetraders database (README.md,
  # step 1). Not the postgres admin.
  ConnectionStrings__DefaultConnection: "Host=postgresql.flux-system.svc.cluster.local;Port=5432;Database=spacetraders;Username=spacetraders;Password=<password>"

  # The account token from https://my.spacetraders.io. After every server reset
  # the bot registers a new agent with it.
  SpaceTraders__AccountToken: "<your-account-token>"

  # The agent's callsign: the bot registers the new agent under this name. The
  # faction is COSMIC unless SpaceTraders__AgentFaction is set in api.env.
  SpaceTraders__AgentName: "<callsign>"

  # Guards the bot's internal API (everything but /health). The dashboard sends
  # it as X-Api-Key, so both deployments read it.
  SPACETRADERS_INTERNAL_API_KEY: "<random-secret>"
