# secret.yaml.template
#
# This file documents the shape of the Kubernetes Secret expected by the
# dungeontable namespace.  It is NOT applied directly — the actual secret is
# provisioned by the 1Password Operator via dungeontable-secrets.yaml.
#
# Make sure the following fields exist in the
#   vaults/Gembercluster/items/dungeontable-secrets
# 1Password item so that envFrom injects them correctly into the pod.
#
# To create the secret manually (e.g. for local testing), fill in the values
# below and apply with:
#   kubectl apply -f secret.yaml
#
# WARNING: Do NOT commit the filled-in secret.yaml to version control.

apiVersion: v1
kind: Secret
metadata:
  name: dungeontable-secrets
  namespace: dungeontable
type: Opaque
stringData:
  # Shared passphrase gating the whole app (HTTP Basic auth, any username) —
  # see DungeonTable.Web/Auth/PassphraseAuthMiddleware.cs.
  Auth__Passphrase: "<your-auth-passphrase>"

  # Postgres connection string (Marten document store). Not yet wired up in
  # the app (persistence lands in milestone M5) but the deployment already
  # references this key.
  connectionstring: "Host=<host>;Port=5432;Database=dungeontable;Username=<user>;Password=<password>"
