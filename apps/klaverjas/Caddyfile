# gemberkoekje.nl/klaverjas reaches the pod with its path as is (ingress/klaverjas-route.yaml):
# handle_path strips the prefix, and a bare /klaverjas gets its slash, as for geneaducatie.
# no-cache: browsers revalidate (ETag), so a new version of the page shows on the next load.
# noindex: a design mock, which has no business in search results.
:8080 {
	header Cache-Control "no-cache"
	header X-Robots-Tag "noindex, nofollow"

	handle /ready {
		respond "ok" 200
	}

	redir /klaverjas /klaverjas/ 308

	handle_path /klaverjas/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv
		file_server
	}
}
