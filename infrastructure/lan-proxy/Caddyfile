# Friendly names for the cluster's internal web UIs: <app>.lan.gemberkoekje.nl.
# DNS: *.lan.gemberkoekje.nl and lan.gemberkoekje.nl point at 192.168.1.236 (a private address),
# which the router doesn't forward, so these names only work at home and over Tailscale (whose
# subnet router routes 192.168.1.224/28). Plain HTTP, like the IP:port addresses they replace.
#
# Port 443 answers too, with a certificate from Caddy's own (untrusted) CA, only to redirect to
# http. Chrome and Edge try https first for any http:// address ("HTTPS Upgrades"). While 443 gave
# no answer at all, that attempt hung and the page timed out (2026-11-06); an untrusted certificate
# makes the browser fall back to http at once. Real certificates need a DNS API, which Vimexx lacks.
{
	auto_https disable_redirects
	skip_install_trust
	admin off
	http_port 8080
	https_port 8443
}

# Every name on https: redirect to the same address on http.
https://lan.gemberkoekje.nl, https://*.lan.gemberkoekje.nl {
	tls internal
	redir http://{host}{uri} 302
}

# The start page with links to everything below.
http://lan.gemberkoekje.nl {
	root * /srv
	file_server
}

http://seerr.lan.gemberkoekje.nl {
	reverse_proxy seerr.zeef.svc.cluster.local:5055
}

http://jellyfin.lan.gemberkoekje.nl {
	reverse_proxy jellyfin.zeef.svc.cluster.local:8096
}

http://sonarr.lan.gemberkoekje.nl {
	reverse_proxy sonarr.zeef.svc.cluster.local:8989
}

http://radarr.lan.gemberkoekje.nl {
	reverse_proxy radarr.zeef.svc.cluster.local:7878
}

http://prowlarr.lan.gemberkoekje.nl {
	reverse_proxy prowlarr.zeef.svc.cluster.local:9696
}

http://qbittorrent.lan.gemberkoekje.nl {
	reverse_proxy qbittorrent.zeef.svc.cluster.local:8080
}

http://cleanuparr.lan.gemberkoekje.nl {
	reverse_proxy cleanuparr.zeef.svc.cluster.local:11011
}

http://maintainerr.lan.gemberkoekje.nl {
	reverse_proxy maintainerr.zeef.svc.cluster.local:6246
}

# Grafana serves from /grafana/ (serve_from_sub_path); the bare name lands there.
http://grafana.lan.gemberkoekje.nl {
	redir / /grafana/ 302
	reverse_proxy grafana.monitoring.svc.cluster.local:80
}

# Any other name, and the kubelet's health check (which uses the pod IP).
http://:8080 {
	respond /healthz "ok" 200
	respond "Unknown name. The list is at http://lan.gemberkoekje.nl" 404
}
