# Friendly names for the cluster's internal web UIs: https://<app>.lan.gemberkoekje.nl.
# DNS: *.lan.gemberkoekje.nl and lan.gemberkoekje.nl point at 192.168.1.236 (a private address),
# which the router doesn't forward, so these names only work at home and over Tailscale (whose
# subnet router routes 192.168.1.224/28).
#
# HTTPS with a real Let's Encrypt certificate (certificate.yaml, issued via acme-dns). It is needed:
# the apex sends HSTS with includeSubDomains, so browsers refuse plain http for these names.
# cert-manager renews the certificate; Caddy doesn't reload certificate files by itself, so the
# caddy-restart CronJob (restart.yaml) rolls the pods weekly to pick a renewed one up.
{
	auto_https off
	admin off
	http_port 8080
	https_port 8443
}

(lan_tls) {
	tls /certs/tls.crt /certs/tls.key
}

# Plain http only redirects to https (the Service maps 80 -> 8080 and 443 -> 8443).
http://lan.gemberkoekje.nl, http://*.lan.gemberkoekje.nl {
	redir https://{host}{uri} 308
}

# The start page with links to everything below.
https://lan.gemberkoekje.nl {
	import lan_tls
	root * /srv
	file_server
}

https://seerr.lan.gemberkoekje.nl {
	import lan_tls
	reverse_proxy seerr.zeef.svc.cluster.local:5055
}

