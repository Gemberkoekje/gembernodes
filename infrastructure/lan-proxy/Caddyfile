# Grafana serves from /grafana/ (serve_from_sub_path); the bare name lands there.
https://grafana.lan.gemberkoekje.nl {
	import lan_tls
	redir / /grafana/ 302
	reverse_proxy grafana.monitoring.svc.cluster.local:80
}

# Any other name over https: the certificate covers *.lan, so answer with a pointer.
https://*.lan.gemberkoekje.nl {
	import lan_tls
	respond "Unknown name. The list is at https://lan.gemberkoekje.nl" 404
}

# Any other name over http, and the kubelet's health check (which uses the pod IP).
http://:8080 {
	respond /healthz "ok" 200
	respond "Unknown name. The list is at https://lan.gemberkoekje.nl" 404
}
