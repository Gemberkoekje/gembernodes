        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Gates under construction",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(spacetraders_system_info{namespace=\"spacetraders\", state=\"gate_under_construction\"}) or vector(0)",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Known systems whose gate isn't built: no jump to them until it is. The plan looks at them again hourly.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "none",
          "decimals": 0
        },
