        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Command ship",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (location, activity) (spacetraders_ship_info{namespace=\"spacetraders\"} and on (ship) max by (ship) (spacetraders_ship_status_since_timestamp_seconds{namespace=\"spacetraders\", role=\"COMMAND\"}))",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Where the command ship is and what it does.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "location": 0,
              "activity": 1
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": false,
        "cellHeight": "sm"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Systems",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system, state, gate_state) (spacetraders_system_info{namespace=\"spacetraders\", system=~\"$system\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system) (spacetraders_system_jumps_from_home{namespace=\"spacetraders\", system=~\"$system\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system) (time() - spacetraders_system_explored_timestamp_seconds{namespace=\"spacetraders\", system=~\"$system\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system) (spacetraders_system_facilities{namespace=\"spacetraders\", system=~\"$system\", kind=\"market\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system) (spacetraders_system_facilities{namespace=\"spacetraders\", system=~\"$system\", kind=\"shipyard\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (system) (spacetraders_system_waypoints{namespace=\"spacetraders\", system=~\"$system\", type=~\"ASTEROID|ASTEROID_FIELD|ENGINEERED_ASTEROID\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system) (spacetraders_system_waypoints{namespace=\"spacetraders\", system=~\"$system\", type=\"GAS_GIANT\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system) (spacetraders_system_facilities{namespace=\"spacetraders\", system=~\"$system\", kind=\"uncharted\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system) (spacetraders_system_trade_margin{namespace=\"spacetraders\", system=~\"$system\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Every system the bot knows: what the explore plan knows of it, how many jumps from home, when it was explored, and what is there. Its best trade margin is per unit, before fuel.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "system": 0,
              "state": 1,
              "gate_state": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #G": 8,
              "Value #H": 9,
              "Value #I": 10
            },
            "renameByName": {
              "gate_state": "gate",
              "Value #B": "jumps",
              "Value #C": "explored ago",
              "Value #D": "markets",
              "Value #E": "shipyards",
              "Value #F": "asteroids",
              "Value #G": "gas giants",
              "Value #H": "uncharted",
              "Value #I": "best trade margin"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "jumps"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "home": {
                        "text": "home",
                        "color": "blue",
                        "index": 0
                      },
                      "explored": {
                        "text": "explored",
                        "color": "green",
                        "index": 1
                      },
                      "to_explore": {
                        "text": "to explore",
                        "color": "yellow",
                        "index": 2
                      },
                      "gate_under_construction": {
                        "text": "gate under construction",
                        "color": "orange",
                        "index": 3
                      },
                      "jump_refused": {
                        "text": "jump refused (an hour)",
                        "color": "red",
                        "index": 4
                      },
                      "gate_unknown": {
                        "text": "gate not looked at yet",
                        "color": "text",
                        "index": 5
                      },
                      "no_gate": {
                        "text": "no gate",
                        "color": "text",
                        "index": 6
                      },
                      "cached": {
                        "text": "cached",
                        "color": "text",
                        "index": 7
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "jumps"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "explored ago"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "markets"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "shipyards"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "asteroids"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
