              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Mining and siphoning",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system, good) (spacetraders_system_gathering_sites{namespace=\"spacetraders\", system=~\"$system\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system, good, market) (spacetraders_system_raw_good_price{namespace=\"spacetraders\", system=~\"$system\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system, good) (spacetraders_system_raw_good_supply{namespace=\"spacetraders\", system=~\"$system\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "What can be mined or siphoned in each system, and which ores and gases its markets buy: at how many asteroids (by their deposits) or gas giants, the best price a market pays and where, and the lowest supply among the markets that buy it. SCARCE pays a drone most.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "system": 0,
              "good": 1,
              "Value #A": 2,
              "Value #B": 3,
              "market": 4,
              "Value #C": 5
            },
            "renameByName": {
              "Value #A": "sites",
              "Value #B": "best price",
              "market": "sold at",
              "Value #C": "lowest supply"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "system"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sites"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "best price"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lowest supply"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
