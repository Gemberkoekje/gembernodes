    {
      "id": 9,
      "type": "table",
      "title": "Trades",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system, good, buy_at, sell_at) (spacetraders_system_trade_margin{namespace=\"spacetraders\", system=~\"$system\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (system, good, buy_at, sell_at) (spacetraders_system_trade_volume{namespace=\"spacetraders\", system=~\"$system\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "The best trades within each system, one per good, the five best: buy where it is cheapest, sell where it pays most, margin per unit before fuel, and the units one trade moves (the smaller trade volume).",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "system": 0,
              "good": 1,
              "buy_at": 2,
              "sell_at": 3,
              "Value #A": 4,
              "Value #B": 5
            },
            "renameByName": {
              "buy_at": "buy at",
              "sell_at": "sell at",
              "Value #A": "margin",
              "Value #B": "volume"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "margin",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
