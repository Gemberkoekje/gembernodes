        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(spacetraders_system_info{namespace=\"spacetraders\", state=\"to_explore\"}) or vector(0)",
          "instant": true,
