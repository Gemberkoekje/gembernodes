{
  "uid": "spacetraders-systems",
  "title": "SpaceTraders systems",
  "description": "The systems the SpaceTraders bot knows, the command ship's exploring through jump gates, and what each system offers for mining, trading and ships (Gemberkoekje/projects SpaceTraders/PLAN.md slice 6.11).",
  "tags": [
    "spacetraders"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "SpaceTraders",
      "type": "link",
      "url": "/grafana/d/spacetraders",
      "icon": "dashboard"
    },
    {
      "title": "SpaceTraders markets",
      "type": "link",
      "url": "/grafana/d/spacetraders-markets",
      "icon": "dashboard"
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "system",
        "label": "System",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(spacetraders_system_info{namespace=\"spacetraders\"}, system)",
        "definition": "label_values(spacetraders_system_info{namespace=\"spacetraders\"}, system)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Systems known",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(spacetraders_system_info{namespace=\"spacetraders\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Home, every system the command ship explored, and every system a gate it asked connects to.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Explored",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(spacetraders_system_explored_timestamp_seconds{namespace=\"spacetraders\"}) or vector(0)",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Systems whose every market and shipyard the command ship visited once; home counts once the explore plan runs.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
