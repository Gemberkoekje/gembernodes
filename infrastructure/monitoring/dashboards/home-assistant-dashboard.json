{
  "uid": "home-assistant",
  "title": "Home Assistant",
  "description": "Home Assistant's entities, as its Prometheus integration exports them (apps/home-assistant). One graph per metric: Home Assistant names a sensor's metric after its device class and unit, so a new device appears by itself.",
  "tags": [
    "home-assistant"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "metric",
        "label": "Metric",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({job=\"homeassistant\", __name__=~\"homeassistant_.+\"}, __name__)",
          "refId": "metric"
        },
        "definition": "label_values({job=\"homeassistant\", __name__=~\"homeassistant_.+\"}, __name__)",
        "regex": "/^(?<value>homeassistant_(?!entity_available$|last_updated_time_seconds$|state_change_|entity_info$|area_info$|floor_info$|sensor_timestamp_seconds$|.*_created$)(?<text>.+))$/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Prometheus reads Home Assistant",
      "description": "No: Home Assistant is down, or the token in the 1Password item homeassistant-monitoring is missing or wrong. Prometheus's Targets page shows the error.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(up{job=\"homeassistant\"})",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "color": "red"
                },
                "1": {
                  "text": "Yes",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Available entities",
      "description": "Entities with a state. Unavailable and unknown ones are counted next to it and listed below.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(homeassistant_entity_available{job=\"homeassistant\"} == 1)"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Unavailable or unknown",
      "description": "Entities whose state is unavailable or unknown: a device that dropped out, or an integration that failed to load. Leaves out the domains whose state is unknown until first used (button, event, scene, conversation, notify, tts, stt). Listed below.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(homeassistant_entity_available{job=\"homeassistant\", domain!~\"button|event|scene|conversation|notify|tts|stt\"} == 0) or vector(0)"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "State changes per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(homeassistant_state_change_total{job=\"homeassistant\"}[1h]))"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Unavailable or unknown entities",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "homeassistant_entity_available{job=\"homeassistant\", domain!~\"button|event|scene|conversation|notify|tts|stt\"} == 0",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "friendly_name",
                "entity",
                "domain"
              ]
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "entity"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "${metric:text}",
      "description": "One graph per metric in the Metric picker, one line per entity.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "repeat": "metric",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "{__name__=\"$metric\", job=\"homeassistant\"}",
          "legendFormat": "{{friendly_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
