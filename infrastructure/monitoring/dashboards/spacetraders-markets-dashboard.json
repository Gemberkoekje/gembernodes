{
  "uid": "spacetraders-markets",
  "title": "SpaceTraders markets",
  "description": "The markets and shipyards the SpaceTraders bot has cached, per system, and the game's production chains (Gemberkoekje/projects SpaceTraders/PLAN.md 2.8).",
  "tags": [
    "spacetraders"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "SpaceTraders",
      "type": "link",
      "url": "/grafana/d/spacetraders",
      "icon": "dashboard"
    },
    {
      "title": "SpaceTraders systems",
      "type": "link",
      "url": "/grafana/d/spacetraders-systems",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "system",
        "label": "System",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values({__name__=~\"spacetraders_(market|shipyard)_observed_timestamp_seconds\", namespace=\"spacetraders\"}, system)",
        "definition": "label_values({__name__=~\"spacetraders_(market|shipyard)_observed_timestamp_seconds\", namespace=\"spacetraders\"}, system)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      },
      {
        "name": "market",
        "label": "Market (what we sell into it)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(spacetraders_market_observed_timestamp_seconds{namespace=\"spacetraders\", system=\"$system\"}, waypoint)",
        "definition": "label_values(spacetraders_market_observed_timestamp_seconds{namespace=\"spacetraders\", system=\"$system\"}, waypoint)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      },
      {
        "name": "waypoint",
        "label": "Waypoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values({__name__=~\"spacetraders_(market|shipyard)_observed_timestamp_seconds\", namespace=\"spacetraders\", system=\"$system\"}, waypoint)",
        "definition": "label_values({__name__=~\"spacetraders_(market|shipyard)_observed_timestamp_seconds\", namespace=\"spacetraders\", system=\"$system\"}, waypoint)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "good",
        "label": "Good (price graph)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(spacetraders_market_purchase_price{namespace=\"spacetraders\", system=\"$system\"}, good)",
        "definition": "label_values(spacetraders_market_purchase_price{namespace=\"spacetraders\", system=\"$system\"}, good)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Markets",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(spacetraders_market_observed_timestamp_seconds{namespace=\"spacetraders\", system=\"$system\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Markets the bot knows in this system.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Markets with prices",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count by (waypoint) (spacetraders_market_purchase_price{namespace=\"spacetraders\", system=\"$system\"}))",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Markets a ship has been at, so their prices are known.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Shipyards",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
