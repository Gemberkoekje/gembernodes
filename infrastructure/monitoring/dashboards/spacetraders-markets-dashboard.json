    {
      "id": 8,
      "type": "timeseries",
      "title": "Prices of $good",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (waypoint) (spacetraders_market_purchase_price{namespace=\"spacetraders\", system=\"$system\", good=\"$good\"})",
          "range": true,
          "legendFormat": "{{waypoint}} buy"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (waypoint) (spacetraders_market_sell_price{namespace=\"spacetraders\", system=\"$system\", good=\"$good\"})",
          "range": true,
          "legendFormat": "{{waypoint}} sell"
        }
      ],
      "description": "The chosen good's buy and sell price at each market in this system over time. A price only changes when a ship refreshes the market, so the lines move in steps.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "lineInterpolation": "stepAfter",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Market tree: goods traded in $system",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (good, made_from, used_for) (spacetraders_good_supply_chain{namespace=\"spacetraders\"}) * on (good) group_left () (max by (good) (spacetraders_market_purchase_price{namespace=\"spacetraders\", system=\"$system\"}) * 0 + 1)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (good, buy_at) (label_replace(bottomk by (good) (1, spacetraders_market_purchase_price{namespace=\"spacetraders\", system=\"$system\"} > 0), \"buy_at\", \"$1\", \"waypoint\", \"(.*)\"))",
