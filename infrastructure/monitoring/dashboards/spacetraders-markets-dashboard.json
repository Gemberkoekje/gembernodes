            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (waypoint, ship_type) (spacetraders_shipyard_ship_supply{namespace=\"spacetraders\", system=\"$system\", waypoint=~\"$waypoint\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Ship types per shipyard, with price and supply as last seen (empty until a ship has been there).",
      "transformations": [
