      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (waypoint, ship_type) (spacetraders_shipyard_ship_type{namespace=\"spacetraders\", system=\"$system\", waypoint=~\"$waypoint\"})",
