            },
            "indexByName": {
              "waypoint": 0,
              "ship_type": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "ship_type": "ship type",
              "Value #B": "price",
              "Value #C": "supply"
