          },
          "expr": "count(spacetraders_shipyard_observed_timestamp_seconds{namespace=\"spacetraders\", system=\"$system\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Shipyards the bot knows in this system.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Oldest market data",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - min(spacetraders_market_observed_timestamp_seconds{namespace=\"spacetraders\", system=\"$system\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "How long ago the least recently refreshed market in this system was refreshed. Prices are as last seen.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "dtdurations"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Places",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (waypoint, waypoint_type) (time() - spacetraders_market_observed_timestamp_seconds{namespace=\"spacetraders\", system=\"$system\", waypoint=~\"$waypoint\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (waypoint, waypoint_type) (time() - spacetraders_shipyard_observed_timestamp_seconds{namespace=\"spacetraders\", system=\"$system\", waypoint=~\"$waypoint\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (waypoint) (spacetraders_market_purchase_price{namespace=\"spacetraders\", system=\"$system\", waypoint=~\"$waypoint\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "The markets and shipyards in this system: the waypoint's type, how long ago the bot refreshed each, and how many goods have prices (none until a ship has been there).",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "waypoint": 0,
              "waypoint_type": 1,
              "Value #C": 2,
              "Value #A": 3,
              "Value #B": 4
            },
            "renameByName": {
              "waypoint_type": "type",
              "Value #C": "goods priced",
              "Value #A": "market data age",
              "Value #B": "shipyard data age"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "waypoint"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "market data age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "shipyard data age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "goods priced"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Shipyards",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
