      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Trade goods",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (waypoint, good, kind) (spacetraders_market_purchase_price{namespace=\"spacetraders\", system=\"$system\", waypoint=~\"$waypoint\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (waypoint, good, kind) (spacetraders_market_sell_price{namespace=\"spacetraders\", system=\"$system\", waypoint=~\"$waypoint\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (waypoint, good, kind) (spacetraders_market_trade_volume{namespace=\"spacetraders\", system=\"$system\", waypoint=~\"$waypoint\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (waypoint, good, kind) (spacetraders_market_supply{namespace=\"spacetraders\", system=\"$system\", waypoint=~\"$waypoint\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (waypoint, good, kind) (spacetraders_market_activity{namespace=\"spacetraders\", system=\"$system\", waypoint=~\"$waypoint\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Every good at every market in this system, as last seen. Buy price: what the market charges you; sell price: what it pays you. Kind: EXPORT (the market makes it), IMPORT (it consumes it), EXCHANGE (it only trades it). Volume: units per transaction before the price moves. Sorted by good, so the markets for one good are together.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "good": 0,
              "waypoint": 1,
              "kind": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7
            },
            "renameByName": {
              "Value #A": "buy price",
              "Value #B": "sell price",
              "Value #C": "volume",
              "Value #D": "supply",
              "Value #E": "activity"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "good"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "buy price"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sell price"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "volume"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "supply"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "SCARCE",
                        "color": "red",
                        "index": 0
                      },
                      "2": {
                        "text": "LIMITED",
                        "color": "orange",
                        "index": 1
                      },
                      "3": {
                        "text": "MODERATE",
                        "color": "yellow",
                        "index": 2
                      },
