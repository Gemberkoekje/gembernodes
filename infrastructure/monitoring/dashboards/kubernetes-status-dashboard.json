{
  "uid": "k8s-status",
  "title": "Kubernetes status",
  "description": "What Lens shows, in Grafana: workloads, pods, Kubernetes events and pod logs, per namespace.",
  "tags": [
    "kubernetes",
    "status"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "kubernetes"
      ],
      "asDropdown": false,
      "title": "Kubernetes",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "definition": "label_values(kube_pod_info, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "pod",
        "label": "Pod (for the logs)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)",
        "definition": "label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "event_type",
        "label": "Events",
        "type": "custom",
        "query": "Warning,Normal",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "Warning",
            "value": "Warning",
            "selected": false
          },
          {
            "text": "Normal",
            "value": "Normal",
            "selected": false
          }
        ]
      },
      {
        "name": "search",
        "label": "Search events and logs",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pods not ready",
      "description": "Pods whose Ready condition is false, finished Job pods left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((kube_pod_status_ready{condition=\"false\", namespace=~\"$namespace\"} == 1) unless on (namespace, pod) (kube_pod_status_phase{phase=\"Succeeded\"} == 1)) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Containers stuck",
      "description": "Containers waiting with one of: CrashLoopBackOff, ImagePullBackOff, ErrImagePull, CreateContainerConfigError, CreateContainerError, InvalidImageName. The Pods table says which.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(kube_pod_container_status_waiting_reason{namespace=~\"$namespace\", reason=~\"CrashLoopBackOff|ImagePullBackOff|ErrImagePull|CreateContainerConfigError|CreateContainerError|InvalidImageName\"} == 1) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Workloads short of pods",
      "description": "Deployments, StatefulSets and DaemonSets with fewer ready pods than they want.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(\n  (sum by (namespace, deployment) (kube_deployment_spec_replicas{namespace=~\"$namespace\"}) > sum by (namespace, deployment) (kube_deployment_status_replicas_available{namespace=~\"$namespace\"}))\n  or (sum by (namespace, statefulset) (kube_statefulset_replicas{namespace=~\"$namespace\"}) > sum by (namespace, statefulset) (kube_statefulset_status_replicas_ready{namespace=~\"$namespace\"}))\n  or (sum by (namespace, daemonset) (kube_daemonset_status_desired_number_scheduled{namespace=~\"$namespace\"}) > sum by (namespace, daemonset) (kube_daemonset_status_number_ready{namespace=~\"$namespace\"}))\n) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Restarts (1 h)",
      "description": "Container restarts in the last hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[1h]))) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Warning events (1 h)",
      "description": "Kubernetes events of type Warning in the last hour (failed pulls, mounts, probes, back-offs). Read them in the events panel below.",
      "datasource": {
        "type": "loki",
        "uid": "grafana-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafana-loki"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"kubernetes-events\", object_namespace=~\"$namespace|\"} | logfmt | type=\"Warning\" [1h]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Flux objects not ready",
      "description": "Kustomizations, HelmReleases and sources whose Ready condition isn't True, in any namespace. The Flux dashboard (link at the top) says why.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(gotk_resource_info{ready!=\"True\"}) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Workloads",
      "description": "Every Deployment, StatefulSet and DaemonSet: how many pods it wants and how many are ready. Short ones first.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, kind, workload) (\n  label_replace(label_replace(kube_deployment_spec_replicas{namespace=~\"$namespace\"}, \"kind\", \"Deployment\", \"\", \"\"), \"workload\", \"$1\", \"deployment\", \"(.+)\")\n  or label_replace(label_replace(kube_statefulset_replicas{namespace=~\"$namespace\"}, \"kind\", \"StatefulSet\", \"\", \"\"), \"workload\", \"$1\", \"statefulset\", \"(.+)\")\n  or label_replace(label_replace(kube_daemonset_status_desired_number_scheduled{namespace=~\"$namespace\"}, \"kind\", \"DaemonSet\", \"\", \"\"), \"workload\", \"$1\", \"daemonset\", \"(.+)\")\n)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, kind, workload) (\n  label_replace(label_replace(kube_deployment_status_replicas_available{namespace=~\"$namespace\"}, \"kind\", \"Deployment\", \"\", \"\"), \"workload\", \"$1\", \"deployment\", \"(.+)\")\n  or label_replace(label_replace(kube_statefulset_status_replicas_ready{namespace=~\"$namespace\"}, \"kind\", \"StatefulSet\", \"\", \"\"), \"workload\", \"$1\", \"statefulset\", \"(.+)\")\n  or label_replace(label_replace(kube_daemonset_status_number_ready{namespace=~\"$namespace\"}, \"kind\", \"DaemonSet\", \"\", \"\"), \"workload\", \"$1\", \"daemonset\", \"(.+)\")\n)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "short",
            "binary": {
              "left": "Value #A",
              "operator": "-",
              "right": "Value #B"
            },
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "kind": 1,
              "workload": 2,
              "Value #A": 3,
              "Value #B": 4,
              "short": 5
            },
            "renameByName": {
              "Value #A": "wants",
              "Value #B": "ready"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "short",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "short"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Pods",
      "description": "Every pod except finished Job pods: its phase, containers not ready, restarts since it started, why a container is waiting (if it is), its node and its age. Problems first.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, pod, phase) (kube_pod_status_phase{namespace=~\"$namespace\", phase!=\"Succeeded\"} == 1)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(count by (namespace, pod) (kube_pod_container_status_ready{namespace=~\"$namespace\"}) - sum by (namespace, pod) (kube_pod_container_status_ready{namespace=~\"$namespace\"})) unless on (namespace, pod) (kube_pod_status_phase{phase=\"Succeeded\"} == 1)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, pod) (kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}) unless on (namespace, pod) (kube_pod_status_phase{phase=\"Succeeded\"} == 1)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace, pod, reason) (kube_pod_container_status_waiting_reason{namespace=~\"$namespace\"} == 1)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace, pod, node) (kube_pod_info{namespace=~\"$namespace\"}) unless on (namespace, pod) (kube_pod_status_phase{phase=\"Succeeded\"} == 1)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - max by (namespace, pod) (kube_pod_created{namespace=~\"$namespace\"})) unless on (namespace, pod) (kube_pod_status_phase{phase=\"Succeeded\"} == 1)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "Value #D": true,
              "Value #E": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "phase": 2,
              "Value #B": 3,
              "Value #C": 4,
              "reason": 5,
              "node": 6,
              "Value #F": 7
            },
            "renameByName": {
              "Value #B": "not ready",
              "Value #C": "restarts",
              "reason": "waiting because",
              "Value #F": "age"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "not ready",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "not ready"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "restarts"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "waiting because"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "phase"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Running": {
                        "color": "green",
                        "index": 0
                      },
                      "Pending": {
                        "color": "orange",
                        "index": 1
                      },
                      "Failed": {
                        "color": "red",
                        "index": 2
                      },
                      "Unknown": {
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Kubernetes events",
      "description": "What Kubernetes itself reports: scheduling, image pulls, volume mounts, probes, back-offs, scaling. Kubernetes keeps events for an hour; Loki keeps them as long as the logs. Events about nodes (no namespace) always show.",
      "datasource": {
        "type": "loki",
        "uid": "grafana-loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafana-loki"
          },
          "expr": "{job=\"kubernetes-events\", object_namespace=~\"$namespace|\"} |~ \"(?i)$search\" | logfmt | type=~\"$event_type\" | line_format `{{.type}} · {{ or .object_namespace \"cluster\" }} · {{.kind}}/{{.name}} · {{.reason}}: {{.msg}}`"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
