          "url": "/status/startup-snapshots/${snapshot}/download",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "($r := $; [{\"captured\": $r.CapturedAt, \"why\": $r.Reason, \"credits\": $r.Agent.Credits, \"ships\": $count($r.Ships), \"contracts\": $count($r.Contracts), \"systems\": $count($r.Systems), \"markets\": $count($r.Systems.Waypoints[Market]), \"shipyards\": $count($r.Systems.Waypoints[Shipyard])}])",
          "columns": [
            {
              "selector": "captured",
