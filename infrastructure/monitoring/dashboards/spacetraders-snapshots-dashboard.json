{
  "uid": "spacetraders-snapshots",
  "title": "SpaceTraders snapshots",
  "description": "The SpaceTraders bot's snapshots of the game state: the list, a download of each as JSON, and what the picked one holds (Gemberkoekje/projects SpaceTraders/PLAN.md slice 2.15). Read from the bot's internal API with the Infinity data source.",
  "tags": [
    "spacetraders"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "links": [
    {
      "title": "SpaceTraders",
      "type": "link",
      "url": "/grafana/d/spacetraders",
      "icon": "dashboard",
      "includeVars": true
    },
    {
      "title": "SpaceTraders markets",
      "type": "link",
      "url": "/grafana/d/spacetraders-markets",
      "icon": "dashboard",
      "includeVars": true
    },
    {
      "title": "SpaceTraders systems",
      "type": "link",
      "url": "/grafana/d/spacetraders-systems",
      "icon": "dashboard",
      "includeVars": true
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "reset_date",
        "label": "Reset",
        "description": "The server reset whose discoveries the journal panel shows, newest first (slice 2.13). The snapshots are the run under way's: the bot keeps only its own agent's.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(spacetraders_agent_credits{namespace=\"spacetraders\"}, reset_date)",
        "definition": "label_values(spacetraders_agent_credits{namespace=\"spacetraders\"}, reset_date)",
        "refresh": 2,
        "sort": 2,
        "multi": true,
        "includeAll": false,
        "options": [],
        "current": {}
      },
      {
        "name": "snapshot",
        "label": "Snapshot",
        "description": "The snapshot the panels below show, newest first.",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "spacetraders-api"
        },
        "query": {
          "queryType": "infinity",
          "refId": "variable",
          "infinityQuery": {
            "refId": "variable",
            "datasource": {
              "type": "yesoreyeram-infinity-datasource",
              "uid": "spacetraders-api"
            },
            "type": "json",
            "source": "url",
            "parser": "backend",
            "format": "table",
            "url": "/status/startup-snapshots",
            "url_options": {
              "method": "GET",
              "data": ""
            },
            "root_selector": "($rows := [$map($, function($s){ {\"__text\": \"#\" & $string($s.id) & \" · \" & $replace($substring($s.capturedAt, 0, 16), \"T\", \" \") & \" UTC · \" & $s.reason, \"__value\": $string($s.id)} })]; $count($rows) > 0 ? $rows : [])",
            "columns": [
              {
                "selector": "__text",
                "text": "__text",
                "type": "string"
              },
              {
                "selector": "__value",
                "text": "__value",
                "type": "string"
              }
            ],
            "filters": [],
            "computed_columns": []
          }
        },
        "definition": "Snapshots of the run under way, newest first",
        "refresh": 2,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Snapshots of the run under way",
      "description": "Every snapshot the bot keeps of the run under way, newest first: one at every start and one whenever the cached shipyards or markets list a ship type or good no snapshot of the run held yet, with what was new and where (SpaceTraders slice 2.15). It keeps the run's first (\"(first)\") and the 10 newest. \"JSON\" downloads the snapshot as the bot saved it, through Grafana; \"show below\" picks it for the panels below. Read from the bot's internal API (/status/startup-snapshots) with the Infinity data source. A long \"discovered\" shows in full in the cell's inspect view, and under \"New in this snapshot\" once shown below.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "spacetraders-api"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "spacetraders-api"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/status/startup-snapshots",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "($rows := [$map($, function($s){ {\"id\": $s.id, \"captured\": $s.capturedAt, \"why\": $s.reason & ($s.isInitialSnapshot ? \" (first)\" : \"\"), \"discovered\": $s.discovered, \"file\": \"JSON\", \"show\": \"show below\"} })]; $count($rows) > 0 ? $rows : [])",
          "columns": [
            {
              "selector": "id",
              "text": "id",
              "type": "number"
            },
            {
              "selector": "captured",
              "text": "captured",
              "type": "timestamp"
            },
            {
              "selector": "why",
              "text": "why",
              "type": "string"
            },
            {
              "selector": "discovered",
              "text": "discovered",
              "type": "string"
            },
            {
              "selector": "file",
              "text": "file",
              "type": "string"
            },
            {
              "selector": "show",
              "text": "show",
              "type": "string"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "captured": 0,
              "why": 1,
              "file": 2,
              "show": 3,
              "discovered": 4,
              "id": 5
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 60,
            "inspect": true
          },
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "captured"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.minWidth",
                "value": 150
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "why"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 90
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "discovered"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "file"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Download snapshot ${__data.fields.id} as JSON",
                    "targetBlank": true,
                    "url": "/grafana/api/datasources/proxy/uid/spacetraders-api/status/startup-snapshots/${__data.fields.id}/download"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "show"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show snapshot ${__data.fields.id} below",
                    "url": "/grafana/d/spacetraders-snapshots?var-snapshot=${__data.fields.id}&${reset_date:queryparam}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Snapshot ${snapshot}",
      "description": "The snapshot picked above (Snapshot): when and why it was taken, and how much it holds. It holds every market and shipyard the bot had cached, as last seen, also where no ship was.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "spacetraders-api"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
