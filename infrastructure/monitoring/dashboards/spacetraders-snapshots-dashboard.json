          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/status/startup-snapshots/${snapshot}/download",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "($rows := [$exists(Discoveries) ? Discoveries.($d := $; {\"kind\": $d.Kind = \"ShipType\" ? \"ship type\" : \"good\", \"symbol\": $d.Symbol, \"where\": $join($d.Waypoints, \", \")}) : []]; $count($rows) > 0 ? $rows : [])",
