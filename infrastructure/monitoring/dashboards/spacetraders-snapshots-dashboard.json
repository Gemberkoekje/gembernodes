          "root_selector": "($rows := [Ships.($s := $; {\"ship\": $s.Symbol, \"type\": $s.ShipType, \"where\": $s.Status = \"IN_TRANSIT\" ? \"→ \" & ($exists($s.DestinationSymbol) ? $s.DestinationSymbol : $s.WaypointSymbol) : $s.WaypointSymbol, \"status\": $s.Status, \"fuel\": $string($s.FuelCurrent) & \"/\" & $string($s.FuelCapacity), \"cargo\": $string($s.CargoUnits) & \"/\" & $string($s.CargoCapacity), \"goal\": $s.Goal.Kind})]; $count($rows) > 0 ? $rows : [])",
