            },
            {
              "selector": "markets",
              "text": "markets",
              "type": "number"
            },
            {
              "selector": "shipyards",
              "text": "shipyards",
              "type": "number"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "captured": 0,
              "why": 1,
              "credits": 2,
              "ships": 3,
              "contracts": 4,
              "systems": 5,
              "markets": 6,
              "shipyards": 7
