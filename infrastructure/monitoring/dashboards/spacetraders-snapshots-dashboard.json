    {
      "id": 5,
      "type": "table",
      "title": "Shipyards in this snapshot",
      "description": "Every shipyard the bot had cached, one row per ship type it sells. Price, supply, activity, tank (fuel), hold (cargo, from the cargo hold modules), mounts and modules come from the listing, which the game shows only while one of our ships is there: a row without them is a type no ship of ours has seen listed there. \"seen\" is when the listing was stored.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "spacetraders-api"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "spacetraders-api"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/status/startup-snapshots/${snapshot}/download",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "($rows := [Systems.Waypoints[Shipyard].($w := Waypoint.Symbol; $sy := Shipyard; $sy.ShipTypes.($t := type; $l := $sy.Ships[type = $t]; {\"shipyard\": $w, \"ship type\": $t, \"price\": $l.purchasePrice, \"supply\": $l.supply, \"activity\": $l.activity, \"fuel\": $l.frame.fuelCapacity, \"cargo\": $sum($l.modules[$contains(symbol, \"CARGO_HOLD\")].capacity), \"mounts\": $join($l.mounts.$substringAfter(symbol, \"MOUNT_\"), \", \"), \"modules\": $join($l.modules.$substringAfter(symbol, \"MODULE_\"), \", \"), \"seen\": $sy.LastObservedAt}))]; $count($rows) > 0 ? $rows : [])",
          "columns": [
            {
              "selector": "shipyard",
              "text": "shipyard",
              "type": "string"
            },
            {
              "selector": "ship type",
              "text": "ship type",
              "type": "string"
            },
            {
              "selector": "price",
              "text": "price",
              "type": "number"
            },
            {
              "selector": "supply",
              "text": "supply",
              "type": "string"
            },
            {
              "selector": "activity",
              "text": "activity",
              "type": "string"
            },
            {
              "selector": "fuel",
              "text": "fuel",
              "type": "number"
            },
            {
              "selector": "cargo",
              "text": "cargo",
              "type": "number"
            },
            {
              "selector": "mounts",
              "text": "mounts",
              "type": "string"
            },
            {
              "selector": "modules",
              "text": "modules",
              "type": "string"
            },
            {
              "selector": "seen",
              "text": "seen",
              "type": "timestamp"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "shipyard": 0,
              "ship type": 1,
              "price": 2,
              "supply": 3,
              "activity": 4,
              "fuel": 5,
              "cargo": 6,
              "mounts": 7,
              "modules": 8,
              "seen": 9
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 60,
            "inspect": true
          },
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "price"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "supply"
            },
            "properties": [
