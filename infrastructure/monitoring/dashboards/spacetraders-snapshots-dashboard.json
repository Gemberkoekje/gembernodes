              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "New in this snapshot",
      "description": "The ship types and goods new to the run that the snapshot was taken for, and the shipyards or markets that list them. Empty for a snapshot taken at a start.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "spacetraders-api"
      },
      "gridPos": {
        "h": 10,
