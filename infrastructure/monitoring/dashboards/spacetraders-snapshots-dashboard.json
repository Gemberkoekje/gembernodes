      "title": "Ships in this snapshot",
      "description": "Each ship as the bot had cached it: its registration type, where it was (in transit, an arrow and where it was flying to, as the dashboard's fleet table shows it), fuel and hold, and the kind of goal it had.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "spacetraders-api"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 8,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "spacetraders-api"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/status/startup-snapshots/${snapshot}/download",
          "url_options": {
